{
  "name": "ansh-chandpara-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "ship": "bash tools/ship.sh",
    "status": "bash tools/status.sh",
    "media": "node tools/pipeline/process-masters.mjs",
    "media:manifest": "node tools/pipeline/build-media-manifest.mjs",
    "media:check": "node tools/pipeline/build-media-manifest.mjs --check",
    "media:validate": "node tools/pipeline/build-media-manifest.mjs --validate",
    "prebuild": "npm run media:validate",
    "media:sync": "node --env-file=.env.local tools/pipeline/sync-to-store.mjs public/projects",
    "media:verify": "node --env-file=.env.local tools/pipeline/verify-referenced.mjs"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1110.0",
    "@aws-sdk/lib-storage": "^3.1110.0",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.3",
    "vite": "^5.4.11"
  }
}
